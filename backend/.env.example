# ===========================================
# Amy Electric Lead Agent - Environment Config
# ===========================================
# Copy this file to .env and fill in the values

# Database (required)
DATABASE_URL=postgresql+asyncpg://leadagent:YOUR_SECURE_PASSWORD@localhost:5433/leadagent

# Redis (optional - defaults shown)
REDIS_URL=redis://localhost:6379/0

# Ollama (optional - defaults shown)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# API Authentication (required for production)
API_KEY=generate-a-secure-random-string-here

# SendGrid Email (optional - for sending outreach emails)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=amy@amyelectric.com

# Hunter.io API (optional - for email enrichment)
HUNTER_API_KEY=

# Application (optional - defaults shown)
DEBUG=false
